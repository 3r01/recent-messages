# Render TAILNET_IP to this host's literal private address. No public wildcard.
server {
    listen TAILNET_IP:2791;
    server_name _;
    access_log off;
    client_max_body_size 16m;
    location = /api/v2/metrics { proxy_pass http://127.0.0.1:2790; }
    location = /health/ready { proxy_pass http://127.0.0.1:2790; }
    location = /health/live { proxy_pass http://127.0.0.1:2790; }
    location ^~ /internal/v1/ {
        proxy_pass http://127.0.0.1:2790;
        proxy_read_timeout 10s;
    }
    location = /dashboard { return 302 /dashboard/; }
    location ^~ /dashboard/ {
        proxy_pass http://127.0.0.1:2788/;
        proxy_read_timeout 5s;
    }
    location / { return 404; }
}
