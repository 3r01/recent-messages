[Unit]
Description=Readiness-gated Recentmessages tunnel replica
After=network-online.target nginx.service recent-messages2.service
Wants=network-online.target recent-messages2.service
Requires=nginx.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/recent-messages-ops/tunnel-readiness.py
ExecStopPost=/usr/bin/systemctl stop cloudflared-rm.service
Restart=always
RestartSec=5s
TimeoutStopSec=45s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
